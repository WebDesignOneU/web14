# Base de la API SWAPI usada por el showcase.
# Por defecto la app usa https://swapi.dev/api (con mirrors de respaldo en el código).
# Puedes apuntar a un mirror si el original no responde:
#   VITE_SWAPI_BASE_URL=https://swapi.py4e.com/api
#   VITE_SWAPI_BASE_URL=https://swapi.info/api
#
# Recuerda: en Vite las variables expuestas al cliente deben empezar por "VITE_".
VITE_SWAPI_BASE_URL=https://swapi.dev/api
